{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://bookbinder.local/assetlab/export-manifest.schema.json","title":"Bookbinder Asset Export Manifest v3","type":"object","additionalProperties":false,
  "required":["manifestVersion","identityKind","logicalID","authoringDescriptor","gameIdentity","renderHints","adapterDiagnostics","pipelineVersions","outputs"],
  "properties":{
    "manifestVersion":{"const":3},"identityKind":{"enum":["creature","flora"]},"logicalID":{"type":"string","minLength":1},
    "authoringDescriptor":{"oneOf":[{"$ref":"identity-descriptor.schema.json"},{"$ref":"flora-identity.schema.json"}]},
    "gameIdentity":{"oneOf":[{"$ref":"live-creature-identity.schema.json"},{"$ref":"live-flora-identity.schema.json"}]},
    "renderHints":{"$ref":"render-hints.schema.json"},
    "adapterDiagnostics":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["severity","code","field","message"],"properties":{"severity":{"enum":["info","warning","error"]},"code":{"type":"string"},"field":{"type":"string"},"message":{"type":"string"}}}},
    "pipelineVersions":{"type":"object","minProperties":1,"additionalProperties":{"type":["string","integer"]}},
    "outputs":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["profile","file","pixelWidth","pixelHeight","pivot","pixelHash"],"properties":{"profile":{"type":"string"},"file":{"type":"string"},"pixelWidth":{"type":"integer","minimum":1},"pixelHeight":{"type":"integer","minimum":1},"pivot":{"type":"object","additionalProperties":false,"required":["x","y"],"properties":{"x":{"type":"integer"},"y":{"type":"integer"}}},"pixelHash":{"type":"string","pattern":"^[0-9a-f]{8}$"}}}}
  },
  "allOf":[
    {"if":{"properties":{"identityKind":{"const":"creature"}}},"then":{"properties":{"authoringDescriptor":{"$ref":"identity-descriptor.schema.json"},"gameIdentity":{"$ref":"live-creature-identity.schema.json"}}}},
    {"if":{"properties":{"identityKind":{"const":"flora"}}},"then":{"properties":{"authoringDescriptor":{"$ref":"flora-identity.schema.json"},"gameIdentity":{"$ref":"live-flora-identity.schema.json"}}}}
  ]
}
