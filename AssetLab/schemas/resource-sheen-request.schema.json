{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bookbinder.resource-sheen-request.v1.1",
  "title": "Bookbinder Resource Sheen Request v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["resourceID", "bodyKind", "revealed", "discovered", "state", "phase", "tick", "reduceMotion", "bodyCommands"],
  "properties": {
    "resourceID": {"enum": ["rubble", "clay", "ore", "copper", "silver", "gold", "quartz", "obsidian", "salt", "sulfur", "mercury", "adamant", "fiber", "timber", "pulp", "resin", "toxin", "spore", "reagent", "ichor", "rift_glass", "essence_raw", "mote"]},
    "bodyKind": {"enum": ["resourceCue", "wildDrop"]},
    "revealed": {"type": "boolean"},
    "discovered": {"type": "boolean"},
    "state": {"enum": ["remaining", "exhausted"]},
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapSeedUInt64Decimal", "runIndex", "x", "y"],
      "properties": {
        "mapSeedUInt64Decimal": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,19})$"},
        "runIndex": {"type": "integer", "minimum": 0},
        "x": {"type": "integer"},
        "y": {"type": "integer"}
      }
    },
    "tick": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "reduceMotion": {"type": "boolean"},
    "bodyCommands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["op", "x", "y", "w", "h", "color"],
        "properties": {
          "op": {"const": "rect"},
          "x": {"type": "integer"},
          "y": {"type": "integer"},
          "w": {"type": "integer", "minimum": 1},
          "h": {"type": "integer", "minimum": 1},
          "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
        }
      }
    }
  }
}
