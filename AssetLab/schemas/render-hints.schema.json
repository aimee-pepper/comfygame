{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookbinder.local/assetlab/render-hints.schema.json",
  "title": "Bookbinder Visual Render Hints",
  "oneOf": [
    { "$ref": "#/$defs/flora" },
    { "$ref": "#/$defs/creature" }
  ],
  "$defs": {
    "flora": {
      "title": "Flora render hints v1",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion"],
      "properties": { "schemaVersion": { "const": 1 } }
    },
    "creature": {
      "title": "Creature render hints v2",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "bodyPlan", "cranialFeature"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "bodyPlan": { "enum": ["quadruped", "biped", "serpentine", "segmented", "radial", "piscine", "amorphous"] },
        "cranialFeature": { "enum": ["none", "longEars", "horns", "crest", "sensoryFan"] }
      }
    }
  }
}
