  "policy": {
    "field": "creatureRoleCoherenceVersion",
    "value": 1,
    "requiresCreatureBodyHabitatVersion": 1,
    "nil": "preserve-legacy-casts-names-and-keys"
  },
  "retainedCausalRules": {
    "ordinaryBudget": "existing-fixed-budget",
    "vitality": "cast-and-population-only",
    "trophicDepthCap": "existing-FloraRules.productivity*1.2",
    "diet": "unspecified-no-feeding-simulation",
    "roleNeverChanges": [
      "traits",
      "habitat",
      "counts",
      "spawnWeights",
      "RNG",
      "Danger",
      "combat",
      "materialReceipts",
      "teachingEligibility"
    ]
  },
  "matching": {
    "order": [
      "ambusher",
      "pursuer",
      "tank",
      "grazer",
      "swarmer",
      "apex",
      "drifter",
      "sentinel"
    ],
    "fit": "existing-IdentityRegion.fit-formulas",
    "threshold": 0.78,
    "tolerance": 25,
    "selection": "hard-eligibility-before-highest-soft-fit; retain-first-in-order-tie",
    "fallback": "composed-physical-description"
  },
  "gates": {
    "ambusher": "armament.total>=25 && dominant==pierce && reach==close && defence==crypsis",
    "pursuer": "ordinary-mobile && !sessile && !actualApex",
    "tank": "covering.armourValue>0",
    "grazer": "false; no confirmed plant-feeding identity in this policy",
    "swarmer": "delivery==multi || delivery==area",
    "apex": "false-for-ordinary-cast; preserve-separate-Apex-path",
    "drifter": "habitat==aquatic || habitat==aerial",
    "sentinel": "reach==far"
  },
  "unarmed": {
    "threshold": 25,
    "massDamage": "preserved",
    "delivery": "preserved",
    "farFirstStrike": "preserved",
    "doesNotProve": "diet-or-harmlessness"
  },
  "nounByHabitat": {
    "aerial": "flier",
