{
  "schemaVersion": 1,
  "authorityID": "creature-habitat-v1",
  "updated": "2026-08-21",
  "status": "settled-design-reversible-tuning-not-live",
  "habitats": ["terrestrial", "shore", "aquatic", "aerial"],
  "minimumComponentTileCount": 2,
  "componentID": "minimumRowMajorTileIndex",
  "tileSets": {
    "liquidWater": "ground == water || ground == deepWater",
    "startConnected": "fourWayReachableFromEntryUsingCurrentPassableTiles",
    "terrestrial": "startConnected && ground != water && ground != deepWater",
    "shore": "shallowWater || (startConnectedNonWater && cardinallyAdjacentToLiquidWater)",
    "aquatic": "fourWayConnectedComponentOfShallowAndDeepWater",
    "aerial": "startConnected && ground != deepWater && ground != chasm"
  },
  "availability": {
    "terrestrial": "hasComponentAtLeast2",
    "shore": "hasComponentAtLeast2",
    "aquatic": "hasComponentAtLeast2",
    "aerial": "hasComponentAtLeast2"
  },
  "inputs": {
    "waterFraction": "100 * liquidWaterTileCount / nonChasmTileCount",
    "shoreFraction": "100 * shoreUnionTileCount / nonChasmTileCount",
    "liquidHydrology": "hydrology.peak * clamp(hydrology.standingShare + hydrology.flowingShare, 0, 1)",
    "verticality": "relief.aspect.verticality",
    "motion": "atmosphere.aspect.motion"
  },
  "baseWeights": {
    "terrestrial": "20 + 0.80 * (100 - waterFraction)",
    "shore": "0.60 * shoreFraction + 0.25 * liquidHydrology",
    "aquatic": "0.80 * waterFraction + 0.30 * liquidHydrology",
    "aerial": "0.35 * verticality + 0.35 * motion"
  },
  "repeatHabitatMultiplier": 0.65,
  "firstSpeciesRule": "sampleOnlyHabitatsWithAtLeastOnePlayerContactEligibleComponent",
  "contactEligibility": {
    "terrestrial": "anyEligibleComponent",
    "shore": "componentContainsStartConnectedPassableTile",
    "aquatic": "componentContainsStartConnectedShallowWaterTile",
    "aerial": "anyEligibleComponent"
  },
  "bodyPlanWeights": {
    "terrestrial": { "quadruped": 45, "biped": 15, "serpentine": 15, "segmented": 10, "radial": 7, "amorphous": 8, "piscine": 0 },
    "shore": { "quadruped": 35, "biped": 0, "serpentine": 20, "segmented": 15, "radial": 15, "amorphous": 5, "piscine": 10 },
    "aquatic": { "quadruped": 0, "biped": 0, "serpentine": 25, "segmented": 5, "radial": 15, "amorphous": 10, "piscine": 45 },
    "aerial": { "quadruped": 35, "biped": 20, "serpentine": 25, "segmented": 10, "radial": 5, "amorphous": 5, "piscine": 0 }
  },
  "appendageWeightTransforms": {
    "terrestrial": { "none": 1.0, "membrane": 1.0, "feathered": 1.0, "finned": 0.0, "limbed": 1.0 },
    "shore": { "none": 0.75, "membrane": 0.5, "feathered": 0.5, "finned": 2.0, "limbed": 1.5 },
    "aquatic": { "none": 1.5, "membrane": 0.0, "feathered": 0.0, "finned": 5.0, "limbed": 0.5 },
    "aerial": { "none": 0.0, "membrane": 1.0, "feathered": 1.0, "finned": 0.0, "limbed": 0.0 }
  },
  "aerialAppendageFallbackWeights": { "membrane": 1.0, "feathered": 1.0 },
  "ordinaryPlacement": {
    "minimumContactEligibleShare": 0.65,
    "minimumContactEligibleCount": "min(enemyCount, max(1, ceil(enemyCount * 0.65)))",
    "speciesSelection": "equalAmongAwakeRosterSpeciesWithAtLeastOneFreeLegalTileForCurrentQuota",
    "tileSelection": "uniformStableWeightedSelectionWithinLegalComponentAfterEntryDistanceAndOccupancy",
    "noCandidate": "skipPlacementWithoutRerollingEnemyCountOrUsingIllegalHabitat"
  },
  "movement": {
    "terrestrial": "samePersistedEligibleComponent",
    "shore": "samePersistedShoreComponent",
    "aquatic": "samePersistedLiquidWaterComponent",
    "aerial": "samePersistedStartConnectedPassableComponent",
    "noPath": "holdPosition"
  },
  "guardianRule": "highestAppetiteLocalSpeciesWhoseHabitatContainsSiteTileThenStableSpeciesID",
  "gameplayRNG": "unchanged; habitat and morphology use a dedicated versioned ecology stream",
  "diagnostics": [
    "tileCountsByHabitat",
    "componentIDsAndSizes",
    "contactEligibleComponentIDs",
    "inputValues",
    "rawAndRepeatAdjustedWeightsPerSpeciesDraw",
    "selectedHabitats",
    "bodyPlansAndAppendages",
    "spawnCountsByHabitatAndComponent",
    "skippedPlacementReasons"
  ]
}
