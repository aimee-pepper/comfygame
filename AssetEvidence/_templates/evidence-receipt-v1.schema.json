{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bookbinder://asset-evidence/evidence-receipt-v1",
  "title": "Bookbinder non-runtime evidence receipt V1",
  "description": "Classification is not acceptance, source authorship, or runtime authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "family", "version", "variant", "classification", "accepted", "sourceAuthorship", "runtimeAuthority", "gameplayAuthority", "finalArtAcceptance", "gameWikiDisclosure", "authorityPaths", "producerPaths", "files"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "asset-evidence-receipt-v1" },
    "family": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": { "pattern": "^v[0-9]+(?:\\.[0-9]+)*$" },
    "variant": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "classification": { "enum": ["review-evidence", "reference", "candidate-output", "generated-test-artifact", "blocked"] },
    "accepted": { "type": "boolean" },
    "sourceAuthorship": { "const": false },
    "runtimeAuthority": { "const": false },
    "gameplayAuthority": { "const": false },
    "finalArtAcceptance": { "const": false },
    "gameWikiDisclosure": { "enum": ["withheld", "disclosed"] },
    "authorityPaths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "producerPaths": { "type": "array", "items": { "type": "string" } },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "role": { "enum": ["render", "metadata", "interactive-proof", "test-report"] },
          "sha256": { "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}

